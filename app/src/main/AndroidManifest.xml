<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Requested at runtime ONLY when the user triggers voice recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional: only needed on Android 13+ if user explicitly enables the Quick Launch Notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required on Android 11+ to query installed Speech Recognition, Offline Packs, and TTS engines -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="com.google.android.speech.embedded.MANAGE_LANGUAGES" />
        </intent>
        <intent>
            <action android:name="com.google.recognition.action.DOWNLOAD_LANGUAGE" />
        </intent>
    </queries>

    <application
        android:name=".MyExpensesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyExpenses"
        tools:targetApi="33">

        <!-- Main Dashboard Application -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyExpenses">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Lightweight Floating Voice Popup Activity -->
        <!-- Works from Quick Settings Tile, Home Shortcut, Widget, Notification, Digital Assistant / Side Key -->
        <activity
            android:name=".quicklaunch.QuickVoiceActivity"
            android:exported="true"
            android:label="@string/quick_voice_label"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyExpenses.VoiceOverlay">
            <intent-filter>
                <action android:name="com.myexpenses.app.ACTION_QUICK_VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Allows OEM Side-Button / Digital Assistant mapping without Root -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Official Android Digital Assistant / VoiceInteractionService for Samsung Side Button (Press and Hold) -->
        <service
            android:name=".quicklaunch.ExpenseVoiceInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".quicklaunch.ExpenseVoiceInteractionSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".quicklaunch.ExpenseStubRecognitionService"
            android:exported="true"
            android:label="@string/quick_voice_label"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile for 1-tap voice recording from notification shade / lock screen -->
        <service
            android:name=".quicklaunch.ExpenseQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- Home Screen Widget: Today's total + 1-tap Voice Record button -->
        <receiver
            android:name=".quicklaunch.ExpenseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget_info" />
        </receiver>

        <!-- AndroidX per-app language storage service for Android < 13 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
